# Cloudflare Pages reads this file automatically.
# Sensible security headers for a static marketing site.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()

# Images rarely change — let browsers cache them for a week.
/assets/img/*
  Cache-Control: public, max-age=604800

# The blog list changes monthly — always check for a fresh copy so a new post shows up right away.
/blog/posts.json
  Cache-Control: no-cache

# Internal helper files are public once deployed — keep them out of Google.
/tools/*
  X-Robots-Tag: noindex
/*.md
  X-Robots-Tag: noindex
